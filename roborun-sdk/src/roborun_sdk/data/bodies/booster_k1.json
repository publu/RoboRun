{
 "id": "booster_k1",
 "label": "Booster K1",
 "maker": "Booster Robotics",
 "description": "Small legged humanoid with a head camera. Its own controller keeps balance and walks; Roborun streams walk, turn and head commands.",
 "robot": {
  "schema": "manifest.robot-descriptor.v2",
  "kind": "humanoid",
  "family": "booster_k1",
  "arms": 0,
  "base": "legged",
  "head_dof": 2,
  "limits": {
   "vx_m_s": [-0.2, 0.5],
   "vy_m_s": [-0.2, 0.2],
   "vyaw_rad_s": [-0.6, 0.6],
   "head_pitch_rad": [-0.29, 0.75],
   "head_yaw_rad": [-0.785, 0.785],
   "walk_min_pitch_rad": 0.3,
   "head_rate_rad_s": 1.5,
   "deadband_m_s": 0.0
  }
 },
 "motion": {
  "accel_m_s2": [0.5, 0.5],
  "accel_yaw_rad_s2": 1.0,
  "stop_decel_m_s2": 1.5,
  "stop_decel_yaw_rad_s2": 3.0,
  "deadman_s": 0.3,
  "command_hz": 50
 },
 "camera": {
  "name": "head",
  "size_px": [544, 488],
  "hfov_deg": 105,
  "eye_height_m": 0.888,
  "pitch_rad": 0.3,
  "lens": "a wide-angle lens with slight barrel distortion and a nearly square frame"
 },
 "sim": {
  "model": "body_models/booster_k1/K1_22dof.xml",
  "base_body": "trunk",
  "head_camera_frame": "head_booster_stereo_rgb_link",
  "head_joints": {"pitch": "aahead_pitch_joint", "yaw": "aahead_yaw_joint"},
  "stance": {
   "left_hip_pitch_joint": -0.15, "left_knee_pitch_joint": 0.3, "left_ankle_pitch_joint": -0.15,
   "right_hip_pitch_joint": -0.15, "right_knee_pitch_joint": 0.3, "right_ankle_pitch_joint": -0.15,
   "aaleft_shoulder_pitch_joint": 0.2, "left_shoulder_roll_joint": -1.25, "left_elbow_yaw_joint": -0.5,
   "aaright_shoulder_pitch_joint": 0.2, "right_shoulder_roll_joint": 1.25, "right_elbow_yaw_joint": 0.5
  },
  "footprint_m": 0.22
 },
 "agent": {
  "protocol": "booster",
  "port": 8301,
  "routes": {"state": "GET /state", "frame": "GET /frame?stride=1", "command": "POST /cmd {vx, vy, vyaw, head_pitch, head_yaw}", "stop": "POST /stop"}
 },
 "guard": {
  "schema": "roborun-body-guard/1",
  "cell_m": 0.05,
  "extent_m": 3.0,
  "memory_s": 20,
  "floor_band_m": 0.04,
  "obstacle_z_m": [0.06, 1.05],
  "self_radius_m": 0.26,
  "footprint_radius_m": 0.22,
  "depth_range_m": [0.15, 6.0],
  "depth_max_age_s": 0.2,
  "min_points": 6,
  "pixel_stride": 2,
  "unknown_blind_fraction": 0.1,
  "stall_command_m_s": 0.1,
  "stall_measured_m_s": 0.02,
  "stall_s": 1.0,
  "speed_window_s": 0.2,
  "proximity_stop_m": 0.25,
  "corridor_halfwidth_m": 0.32,
  "blind_v_m_s": 0.15,
  "blind_travel_max_m": 0.4
 }
}
